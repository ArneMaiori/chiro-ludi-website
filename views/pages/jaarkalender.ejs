<!DOCTYPE html>
<html lang="nl">
<link rel="stylesheet" href="/css/jaarkalender.css">

<%- include('../partials/head') %>

    <body>
        <%- include('../partials/header') %>
            <%- include('../partials/hero', { title: 'Jaarkalender' , pageKey: 'jaarkalender' }) %>

                <main>
                    <div class="container">
                        <% if (isAdmin) { %>
                            <div class="card m-4 p-3 border-0 shadow-sm bg-light">
                                <h5 id="form-title">Activiteit toevoegen</h5>
                                <form id="event-form" action="/jaarkalender/admin/add-event" method="POST">
                                    <div class="row g-2" id="form-row">
                                        <div id="col-day" class="col-md-2">
                                            <input type="number" name="day" id="input-day" class="form-control"
                                                placeholder="Dag" min="1" max="31" required>
                                        </div>
                                        <div id="col-month" class="col-md-3">
                                            <select name="month" id="input-month" class="form-select" required>
                                                <% maanden.forEach((m, index)=> { %>
                                                    <option value="<%= index %>">
                                                        <%= m %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>
                                        <div id="col-title" class="col-md-4">
                                            <input type="text" name="title" id="input-title" class="form-control"
                                                placeholder="Wat gaan we doen?" required>
                                        </div>
                                        <div id="col-submit" class="col-md-3">
                                            <button type="submit" id="submit-btn"
                                                class="btn btn-success w-100">Toevoegen</button>
                                        </div>
                                        <div id="col-cancel" class="col-md-2 d-none">
                                            <button type="button" id="cancel-btn" class="btn btn-secondary w-100"
                                                onclick="resetForm()">Annuleren</button>
                                        </div>
                                    </div>
                                </form>

                                <% if (!maandkalender) { %>
                                    <div class="mt-3 border-top pt-3">
                                        <button class="btn btn-success w-100" data-bs-toggle="modal"
                                            data-bs-target="#imageModal">
                                            <i class="bi bi-plus-lg"></i> Voeg maandkalender toe
                                        </button>
                                    </div>
                                    <% } %>
                            </div>
                            <% } %>

                                <div class="row">
                                    <div class="<%= maandkalender ? 'col-lg-8' : 'col-12' %>">
                                        <% const datum=new Date(); const jaar=datum.getMonth()>= 8 ? datum.getFullYear()
                                            : datum.getFullYear() - 1; %>
                                            <h1 class="pb-2 mb-4">Planning <%= jaar %>-<%= jaar + 1 %>
                                            </h1>

                                            <div class="calendar-list">
                                                <% let lastMonth=-1; planning.forEach(event=> {
                                                    const d = new Date(event.date);
                                                    const currentMonth = d.getMonth();
                                                    if (currentMonth !== lastMonth) {
                                                    lastMonth = currentMonth; %>
                                                    <h3 id="month-title-<%= lastMonth %>"
                                                        class="border-bottom border-danger border-3 mt-4 fs-4">
                                                        <span class="bg-danger text-white px-2">
                                                            <%= maanden[lastMonth] %>
                                                        </span>
                                                    </h3>
                                                    <% } %>

                                                        <div class="d-flex justify-content-between align-items-center py-2 <%= isAdmin ? 'clickable-event bg-warning-subtle px-2 rounded' : '' %>"
                                                            data-month="<%= currentMonth %>" <% if(isAdmin) { %>
                                                            onclick="editEvent('<%= event._id %>', '<%= d.getDate() %>',
                                                                    '<%= currentMonth %>', '<%= event.title %>')" <% }
                                                                                %>>
                                                                                <p class="m-0">
                                                                                    <strong>
                                                                                        <%= d.getDate() %>:
                                                                                    </strong>
                                                                                    <%= event.title %>
                                                                                </p>
                                                                                <% if (isAdmin) { %>
                                                                                    <div
                                                                                        class="d-flex align-items-center">
                                                                                        <i class="bi bi-pencil-fill me-3 text-muted"
                                                                                            title="Klik om aan te passen"></i>
                                                                                        <button type="button"
                                                                                            class="btn btn-sm bg-danger text-white"
                                                                                            onclick="event.stopPropagation(); deleteEvent('<%= event._id %>', '<%= currentMonth %>', event)">
                                                                                            Verwijder
                                                                                        </button>
                                                                                    </div>
                                                                                    <% } %>
                                                        </div>
                                                        <% }) %>
                                            </div>
                                    </div>

                                    <% if (maandkalender) { %>
                                        <div class="col-lg-4 col-12 mt-5 mt-lg-0">
                                            <h1 class="pb-2 mb-4">Maandkalender</h1>

                                            <% if (isAdmin) { %>
                                                <div class="d-flex justify-content-end mb-2 gap-2 align-items-center">
                                                    <button class="btn btn-warning btn-sm shadow-sm"
                                                        data-bs-toggle="modal" data-bs-target="#imageModal"
                                                        style="height: 31px; width: 31px;">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </button>
                                                    <form action="/jaarkalender/admin/delete-maandkalender"
                                                        method="POST"
                                                        onsubmit="return confirm('Afbeelding verwijderen?')"
                                                        class="m-0 p-0">
                                                        <button type="submit"
                                                            class="btn btn-danger btn-sm shadow-sm d-flex align-items-center justify-content-center text-dark"
                                                            style="height: 31px; width: 31px;">
                                                            <i class="bi bi-trash-fill"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                                <% } %>

                                                    <div class="sticky-lg-top" style="top: 100px;">
                                                        <img src="<%= maandkalender.imageUrl %>"
                                                            class="img-fluid rounded shadow"
                                                            style="aspect-ratio: 3/4; object-fit: cover;"
                                                            alt="maandkalender">
                                                    </div>
                                        </div>
                                        <% } %>
                                </div>
                    </div>
                </main>

                <% if (isAdmin) { %>
                    <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-sm modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Maandkalender</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                                </div>
                                <form action="/jaarkalender/admin/upload-maandkalender" method="POST"
                                    enctype="multipart/form-data">
                                    <div class="modal-body">
                                        <input type="file" name="image" class="form-control" required accept="image/*">
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-primary w-100">Uploaden</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <script src="/js/jaarkalender.js"></script>
                    <% } %>

                        <%- include('../partials/footer') %>
    </body>

</html>