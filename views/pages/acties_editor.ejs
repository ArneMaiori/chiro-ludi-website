<!DOCTYPE html>
<html lang="nl">
<%- include('../partials/head') %>

<body>
    <%- include('../partials/header') %>

    <main class="container my-4">
        <div class="row">
            <div class="col-md-5 mb-4">
                <div class="card shadow h-100 d-flex flex-column">
                    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center py-2">
                        <h5 class="mb-0">Huidige acties</h5>
                        <button class="btn btn-light btn-sm" id="btnNewAction" title="Nieuwe actie aanmaken">
                            <i class="bi bi-plus-md"></i>
                        </button>
                    </div>
                    
                    <div class="card-body p-0 d-flex flex-column flex-grow-1" style="overflow-y: auto; min-height: 0;">
                        <div class="list-group list-group-flush" id="actionsList">
                            <% acties.forEach(actie => { %>
                                <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between action-item"
                                    data-id="<%= actie._id %>" 
                                    data-title="<%= actie.title %>"
                                    data-image-url="<%= actie.imageUrl %>"
                                    data-image-public-id="<%= actie.imagePublicId %>"
                                    data-description="<%= actie.description || '' %>"> <div class="d-flex align-items-center" style="cursor: pointer; flex: 1;" onclick="loadAction(this)">
                                        <img src="<%= actie.imageUrl %>" class="rounded me-3" style="width: 60px; height: 45px; object-fit: cover;">
                                        <span class="text-truncate" style="max-width: 210px;">
                                            <%= actie.title %>
                                        </span>
                                        <span class="text-truncate text-muted ms-2" style="max-width: 150px; font-size: 0.9em;">
                                            <%= actie.description ? actie.description.substring(0, 20) + '...' : '' %> </span>
                                    </div>

                                    <div class="d-flex flex-column">
                                        <button class="btn btn-sm text-secondary btn-move-up" title="Omhoog">
                                            <i class="bi bi-caret-up-fill"></i>
                                        </button>
                                        <button class="btn btn-sm text-secondary btn-move-down" title="Omlaag">
                                            <i class="bi bi-caret-down-fill"></i>
                                        </button>
                                    </div>
                                </div>
                            <% }) %>
                            <% if (acties.length === 0) { %>
                                <div class="p-3 text-center text-muted">Nog geen acties.</div>
                            <% } %>
                        </div>
                    </div>
                    <div class="card-footer text-muted small">
                        Gebruik de pijltjes om de volgorde te wijzigen. Bovenste verschijnt eerst.
                    </div>
                </div>
            </div>

            <div class="col-md-7 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-primary text-white d-flex align-items-center py-2">
                        <h5 class="mb-0" id="editorTitle">Nieuwe actie toevoegen</h5>
                    </div>
                    <div class="card-body">
                        <form id="actionForm" method="POST" action="/acties/admin" enctype="multipart/form-data">
                            <input type="hidden" id="existingImagePublicId" name="existingImagePublicId">
                            <input type="hidden" id="existingImageUrl" name="existingImageUrl">
                            <input type="hidden" id="imageRemoved" name="imageRemoved" value="false">

                            <div class="mb-3">
                                <label class="form-label">Titel *</label>
                                <input type="text" class="form-control" id="titleInput" name="title" required placeholder="Bv. Koekjesverkoop">
                            </div>

                            <div class="mb-3">
                                <label class="form-label d-flex justify-content-between">
                                    Tekst (Optioneel)
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#linkModal">
                                        <i class="bi bi-link"></i> Link invoegen
                                    </button>
                                </label>
                                <textarea class="form-control" id="description" name="description" rows="5" placeholder="Beschrijving..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" id="photoLabel">Foto *</label>

                                <div id="imagePreviewContainer" class="mb-2 text-center p-2 border rounded bg-light d-none">
                                    <img id="previewImage" src="" class="img-fluid" style="max-height: 200px;">
                                </div>

                                <input type="file" class="form-control" id="imageInput" name="image" accept="image/*">
                                <div class="form-text">Verplicht. Rechthoekig formaat aanbevolen.</div>
                                <div id="imageError" class="text-danger small mt-1 d-none">
                                    Selecteer een afbeelding om op te slaan.
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-4"> <button type="button" class="btn btn-secondary" id="btnDelete" style="display: none;">
                                    Verwijderen
                                </button>
                                <button type="submit" class="btn btn-primary flex-grow-1">
                                    Opslaan
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <div class="modal fade" id="linkModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Link invoegen</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tekst</label>
                        <input type="text" id="linkText" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">URL</label>
                        <input type="url" id="linkUrl" class="form-control" placeholder="https://...">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="confirmInsertLink">Invoegen</button>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/acties-editor.js"></script>
</body>
</html>