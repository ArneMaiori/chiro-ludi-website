<footer class="bg-dark text-white py-3">
  <div class="container">
    <div class="text-center">
      <div class="mb-2">
        <a href="https://www.facebook.com/chirolutselusdiepenbeek" target="_blank" class="text-white text-decoration-none me-3 fs-4" title="Volg ons op Facebook">
          <i class="bi bi-facebook"></i>
        </a>
        <a href="https://www.instagram.com/chiroludi" target="_blank" class="text-white text-decoration-none fs-4" title="Volg ons op Instagram">
          <i class="bi bi-instagram"></i>
        </a>
      </div>
      <a href="/privacy" class="text-white text-decoration-none small">Privacyverklaring | </a>
      <% 
        const jaar = new Date().getFullYear(); 
      %>
      <small>&copy; <%= jaar %> Chiro Ludi. Alle rechten voorbehouden. | </small>
      <!-- Admin link/logout -->
      <% if (typeof isAdmin !=='undefined' && isAdmin) { %>
        <a href="#" id="logoutBtn" class="text-white text-decoration-none small">
          <i class="bi bi-box-arrow-right"></i> Uitloggen
        </a>

        <% } else { %>
          <a href="#" class="text-white text-decoration-none small" data-bs-toggle="modal" data-bs-target="#adminModal">
            Admin
          </a>
          <% } %>
    </div>
  </div>
</footer>

<!-- Admin Login Modal -->
<div class="modal fade" id="adminModal" tabindex="-1" aria-labelledby="adminModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="adminModalLabel">Admin Login</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="adminLoginForm">
        <div class="modal-body">
          <div class="mb-3">
            <label for="adminPassword" class="form-label">Wachtwoord</label>
            <input type="password" class="form-control" id="adminPassword" name="password"
              placeholder="Voer admin wachtwoord in" required autofocus>
          </div>
          <div id="errorMessage" class="alert alert-danger d-none" role="alert">
            Verkeerd wachtwoord. Probeer opnieuw.
          </div>
        </div>
        <div class="modal-footer d-flex justify-content-between">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
          <button type="submit" class="btn btn-primary">Inloggen</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/footer.js"></script>
